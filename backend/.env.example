# SlipSlopes backend configuration. Copy to backend/.env for local development.
# Placeholders only - never commit real values.

ENVIRONMENT=development            # development | test | preview | production
LOG_LEVEL=INFO

# PostgreSQL (Supabase: use the connection string from Project Settings -> Database;
# prefix with postgresql+psycopg://). Local default matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://slipslopes:slipslopes@localhost:54329/slipslopes

# Supabase Auth - tokens are verified server-side.
SUPABASE_URL=http://localhost:54321           # https://<project-ref>.supabase.co in production
SUPABASE_JWT_SECRET=                          # legacy HS256 secret (local stack / older projects); leave empty to accept only JWKS-signed tokens
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=                    # SERVER-ONLY secret: storage access and account deletion

# Storage: "supabase" (required in preview/production) or "local" (development only)
STORAGE_BACKEND=local
STORAGE_BUCKET=documents
LOCAL_STORAGE_DIR=.storage
SIGNED_URL_TTL_SECONDS=120

# Queue (Render Key Value / Redis)
REDIS_URL=redis://localhost:6379/0

# Documents
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=1500
OCR_ENABLED=true
OCR_MAX_PAGES=40
PROCESSING_TIME_LIMIT_S=900
MAX_JOB_ATTEMPTS=3

# LLM extraction (optional). With LLM_PROVIDER=none, deterministic rule-based extraction is used.
LLM_PROVIDER=none                  # none | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_EXCERPTS=8
LLM_TIMEOUT_S=180

# HTTP
CORS_ORIGINS=http://localhost:3000            # comma-separated exact origins; '*' is rejected
RATE_LIMIT_EXTRACTION_PER_HOUR=30
RATE_LIMIT_COMPUTE_PER_MINUTE=20
