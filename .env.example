# Copy to .env and fill in to enable live LLM extraction.
# Without a key the app runs in Demo Mode (deterministic rule-based extraction + synthetic household).
ANTHROPIC_API_KEY=
# Model used for contract extraction (default: claude-opus-5-5)
SLIPSLOPES_LLM_MODEL=claude-opus-5-5
# Set to 0 to disable server-side refusal fallbacks
SLIPSLOPES_LLM_FALLBACKS=1
# Max excerpts sent to the LLM per document
SLIPSLOPES_MAX_EXCERPTS=8
